# Single source of truth for bundle identity and versioning.
# Sourced by Scripts/package_app.sh and Scripts/setup_dev_signing.sh.

APP_NAME=Atmark
BUNDLE_ID=io.github.atmarkhq.atmark

# The code-signing identity. TCC grants are keyed to the code signature, so this
# name — and the certificate behind it — must never change once the user has
# granted Automation, Full Disk Access, or Reminders access. Regenerating it does
# not raise an error; it silently invalidates every grant.
SIGNING_IDENTITY="Atmark Local Signing"

MARKETING_VERSION=0.1.0
BUILD_NUMBER=1

MACOS_MIN_VERSION=26.0
MENU_BAR_APP=1
